# ── Public client configuration (safe to ship in the app bundle) ──
# Supabase project (Settings → API). The anon key is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Project settings → API keys). Entitlement: physical_memory_pro
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_

# RevenueCat Test Store key (dev/demo builds; purchases are simulated, no store account needed)
EXPO_PUBLIC_REVENUECAT_TEST_KEY=

# Google sign-in (Google Cloud → APIs & Services → Credentials → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Sign in with Apple (needs the $99/yr Apple Developer Program). Set to true when you have it.
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false

# Optional: OneSignal app id for push orchestration (local notifications work without it)
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# ── Server secrets: NEVER put these in the app. Set with `supabase secrets set` ──
# ANTHROPIC_API_KEY=            (required for AI scene analysis)
# VOYAGE_API_KEY=               (optional; multimodal embeddings)
# REVENUECAT_WEBHOOK_SECRET=    (required for server-side entitlement mirror)
# PM_VISION_MODEL=claude-opus-5 (optional override)
